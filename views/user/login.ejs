<%- include('../partials/header.ejs')%>
        <main>
            <!--
                login form that takes the following:
                email
                password
            -->
            <form action="/user/login" method="POST" name="login" id="login">
                <table id="form-formatting">
                    <h2>User Login</h2>
                    <tbody>
                        <tr>
                            <td><label for="email">Email</label></td>
                            <td><input type="email" name="email" id="email" required /></td>
                        </tr>
                        <tr>
                            <td><label for="password">Password</label></td>
                            <td><input type="password" name="password" id="password" minlength="8" maxlength="64" required /></td>
                        </tr>
                        <tr>
                            <td colspan="2"><button type="submit" id="submit">Login</button></td>
                        </tr>
                    </tbody>
                </table>
            </form>
        </main>

        <%- include("../partials/footer.ejs")%>